{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@openchamber/sdk": ["../sdk/src/index.ts"],
      "@openchamber/sdk/ui": ["../sdk/src/ui/index.ts"]
    }
  },
  "include": ["jev-decisions/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}